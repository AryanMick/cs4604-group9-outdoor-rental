erDiagram
    BUSINESS ||--o{ RENTAL_EQUIPMENT : lists
    BUSINESS ||--o{ MANAGER : employs
    MANAGER ||--o{ EMPLOYEE : supervises
    CUSTOMER ||--o{ RESERVATION : makes
    RENTAL_EQUIPMENT ||--o{ RESERVATION : reserved_in
    RESERVATION ||--o| PAYMENT : receives
    ADMIN ||--o{ DEFINES_ACCESS : assigns
    EMPLOYEE ||--o{ DEFINES_ACCESS : receives
    ADMIN ||--o{ ADMIN_PRIVILEGES : holds
    BUSINESS {
        int_auto_increment business_id PK
        varchar_120 business_name
        varchar_255 address
    }
    RENTAL_EQUIPMENT {
        int_auto_increment equipment_id PK
        varchar_60 equipment_type
        varchar_20 status
        int business_id FK
    }
    CUSTOMER {
        int_auto_increment customer_id PK
        varchar_80 first_name
        varchar_80 last_name
        varchar_254 email UK
    }
    RESERVATION {
        int_auto_increment reservation_id PK
        int equipment_id FK
        int customer_id FK
        varchar_20 status
        date checkout_date
        date due_date
    }
    PAYMENT {
        int_auto_increment payment_id PK
        int reservation_id FK, UK
        decimal_10_2 amount
        date payment_date
    }
    MANAGER {
        int_auto_increment manager_id PK
        varchar_80 first_name
        varchar_80 last_name
        varchar_254 email UK
        int business_id FK
    }
    EMPLOYEE {
        int_auto_increment employee_id PK
        varchar_80 first_name
        varchar_80 last_name
        varchar_254 email UK
        int manager_id FK
    }
    ADMIN {
        int_auto_increment admin_id PK
        varchar_80 first_name
        varchar_80 last_name
    }
    DEFINES_ACCESS {
        int admin_id PK, FK
        int employee_id PK, FK
    }
    ADMIN_PRIVILEGES {
        int admin_id PK, FK
        varchar_60 privilege PK
    }
